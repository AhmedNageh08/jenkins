pipeline {
  agent any
  
  stages {
    stage('Print Credentials') {
      steps {
        script {
          withCredentials([usernamePassword(credentialsId: 'github-cred', usernameVariable: 'USERNAME', passwordVariable: 'PASSWORD')]) {
            echo "Username: ${env.USERNAME}"
            echo "Password: ${env.PASSWORD}"
          }
        }
      }
    }
  }
}

