pipeline {
  agent any
  
  stages {
    stage('Print Credentials') {
      steps {
        script {
          withCredentials([usernamePassword(credentialsId: 'github-cred', usernameVariable: 'user-git', passwordVariable: 'pass-git')]) {
            echo "Username: ${user-git}"
            echo "Password: ${pass-git}"
          }
        }
      }
    }
  }
}
